# Iris 配置 — 复制此文件为 .env 并填入真实值
# cp .env.example .env

# ---- LLM 通道 BASE_URL（Iris 专用，IRIS_ 前缀）----
# 通道名见 config/llm.json 各模型的 channel 字段
IRIS_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
IRIS_BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
IRIS_ZZ_TOKENHUB_BASE_URL=https://your-tokenhub.example.com/codex/v1

# ---- LLM 通道 API_KEY（建议写入 macOS Keychain，勿落 .env 明文）----
# 用命令交互式写入（不落命令历史）：
#   python scripts/run_cli.py secrets-set --key IRIS_DEEPSEEK_API_KEY
#   python scripts/run_cli.py secrets-set --key IRIS_BAILIAN_API_KEY
#   python scripts/run_cli.py secrets-set --key IRIS_ZZ_TOKENHUB_API_KEY

# ---- Trello（可选） ----
TRELLO_API_KEY=your-trello-api-key
TRELLO_TOKEN=your-trello-token

# ---- 飞书（可选） ----
LARK_APP_ID=cli_your_app_id
LARK_APP_SECRET=your_app_secret

# ---- 路径变量（可选，config/*.json 中可通过 ${VAR} 引用） ----
# IRIS_WORK_DOCS_DIR=/path/to/your/work-docs
# IRIS_WIKI_ROOT=/path/to/your/wiki
# IRIS_MEETING_TRANS_DIR=/path/to/your/meeting-transcripts   # 会议转写文件默认搜索目录
# IRIS_PIC_DIR=/path/to/your/pic-dir                         # 飞书文档图片存储目录
