{
  "version": "3.7",
  "app": {
    "name": "Iris",
    "env": "local",
    "language": "zh-CN",
    "timezone": "Asia/Shanghai"
  },
  "paths": {
    "project_root": "${IRIS_PROJECT_ROOT}",
    "output_dir": "${IRIS_OUTPUT_DIR}",
    "temp_dir": "./temp",
    "memory_dir": "${IRIS_MEMORY_DIR}",
    "template_dir": "./templates",
    "log_dir": "./logs"
  },
  "session": {
    "enable_session_memory": true,
    "enable_user_preferences": true,
    "working_context_file": "${IRIS_MEMORY_DIR}/working/working_context.md",
    "session_summary_dir": "${IRIS_MEMORY_DIR}/session",
    "auto_session_summary": true,
    "session_timeout_minutes": 30
  },
  "output": {
    "default_output_mode": "chat",
    "include_citations_by_default": true,
    "answer_style": "balanced"
  },
  "qa": {
    "max_prompt_context_chars": 6000,
    "max_evidence_blocks": 6,
    "max_wiki_hits": 3,
    "max_block_summary_chars": 320,
    "max_wiki_summary_chars": 220
  },
  "retrieval": {
    "synonym_extensions": {},
    "rrf": {
      "lexical_weight": 0.5,
      "vector_weight": 0.5,
      "k": 60,
      "bm25_bonus": 0.02
    },
    "_note": "synonym_extensions: 自定义同义词扩展，格式 {\"词\": [\"同义词1\", \"同义词2\"]}，与内置词典合并。rrf: BM25+向量融合参数，通常无需调整。"
  },
  "organization": {
    "name": "",
    "department": "",
    "domains": [],
    "_note": "name: 公司/组织名称；department: 部门名称；domains: 业务领域列表（用于 LLM Prompt 中的领域背景描述，开源时留空即可）。示例：name='Acme Corp', department='技术研发部', domains=['智能检测','推荐算法','大模型应用']。"
  },
  "biweekly_report": {
    "author_name": "",
    "author_info": "你是一个技术团队负责人的写作助手。",
    "report_author": "",
    "data_sources": [
      "成员周报",
      "会议纪要",
      "讨论思考",
      "方案报告"
    ],
    "lookback_days": 14,
    "dedup_window_days": 35,
    "dept_op_keyword": "",
    "_note": "author_name 用于生成文件名（如 双周报-w25-张三-20260621.md）；author_info 用于 prompt 角色定义；report_author 用于报告末尾署名（留空则不追加署名行）。data_sources 控制扫描的目录（成员周报/会议纪要/讨论思考/方案报告），可增减。lookback_days 控制数据源时间窗口（默认14天）。dedup_window_days 控制历史报告去重窗口（默认35天，覆盖当月+上月最后一期）。dept_op_keyword: 部门级 OP 文档的文件名关键词（默认空=不筛选，生产环境请配置实际部门关键词）。team_okr_patterns（可选）: 个人/团队 OKR 文件名中的团队标识列表（用于排除误取），不配置此项则默认空列表（不排除）；显式配置 [] 可完全禁用排除过滤。"
  },
  "logging": {
    "level": "info",
    "log_to_file": true,
    "record_model_routing": true
  },
  "reminders": {
    "category_inactive_days": 30,
    "category_overrides": {
      "05-会议纪要": 14,
      "06-我的周报": 10,
      "07-成员周报": 10
    },
    "weekly_roster_window_days": 45,
    "weekly_report_gap_days": 14,
    "project_stall_days": 21,
    "project_stall_ignore": [
      "项目-多模态OCR在包袋AI鉴定中的应用",
      "项目-上门百晓生项目",
      "项目-数据智能部2026调薪方案",
      "项目-数据智能部2026调薪规则与推荐方案",
      "项目-质检研发2026调薪规则与方案",
      "项目-质检研发团队2026最终调薪方案"
    ],
    "max_signals_per_type": 15,
    "_note": "主动提醒引擎（reminders 命令 + daily-start 集成，零 LLM 成本）。category_inactive_days: SOURCE 分类目录无更新告警阈值（天），category_overrides 按目录名覆盖；weekly_roster_window_days: 成员周报活跃窗口（超出视为离开统计范围）；weekly_report_gap_days: 周报断档告警阈值；project_stall_days: 项目 Wiki 引用源文档全部超期的停滞阈值；project_stall_ignore: 停滞提醒忽略的项目页面 stem 列表（已完结/已移交/常态化维护的项目不再重复告警）；max_signals_per_type: 每类信号数量上限。"
  },
  "assistant": {
    "output_dir": "",
    "top_k": 5,
    "llm_model": "",
    "short_segment_chars": 15,
    "max_segment_chars": 2000,
    "dedup_window_seconds": 30.0,
    "suggest_every": 3,
    "summary_enabled": true,
    "doc_rewrite_every": 3,
    "panel_theme": "dark",
    "_note": "实时会议助理（meeting-live-assistant）。output_dir: 过程文档输出目录（默认 data/meeting-live/）；top_k: 每段知识库检索条数；llm_model: 段分析 LLM 模型（空=走全局路由）；short_segment_chars: 短段门控阈值；max_segment_chars: 单段长度上限；dedup_window_seconds: 相同文本去重窗口；suggest_every: 建议提问生成间隔；summary_enabled: 退出时生成 AI 会议总结；doc_rewrite_every: 每 N 段重写文档（默认 3）；panel_theme: 面板主题（dark/light，非法值回退 dark）。",
    "asr": {
      "mode": "local",
      "local": {
        "model_dir": "",
        "device": "cpu",
        "sample_rate": 16000,
        "batch_size_s": 60,
        "energy_threshold": 0,
        "_note": "model_dir: Paraformer 模型缓存目录（空=自动检测）；energy_threshold: VAD 能量阈值（0=自动校准噪声底限*2，>0=手动指定固定阈值）"
      },
      "remote": {
        "provider": "",
        "api_base": "",
        "api_key": "",
        "model": "",
        "_note": "云端 ASR 配置（未来扩展）"
      },
      "hotwords_file": "data/assistant/asr_hotwords.txt",
      "replace_dict_file": "data/assistant/asr_replace_dict.json",
      "llm_correct_enabled": true,
      "llm_correct_timeout_ms": 8000,
      "_note": "hotwords_file: 热词文件（每行一个词条，ASR 阶段提升识别准确率）；replace_dict_file: 音近词→正确词映射（Aho-Corasick 词典替换）；llm_correct_enabled: 启用 LLM 深度校正；llm_correct_timeout_ms: LLM 校正超时。热词和替换词典为 assistant 专属，独立于 asr-corrector。"
    }
  },
  "safety": {
    "protect_read_only_sources": true,
    "require_confirmation_for_destructive_actions": true,
    "enforce_write_guard": true,
    "allowed_write_paths": [
      "${IRIS_OUTPUT_DIR}",
      "./temp",
      "${IRIS_MEMORY_DIR}",
      "${IRIS_DATA_DIR}"
    ]
  }
}