{
  "version": "3.2",
  "route_targets": {
    "XX-meeting-notes": {
      "keywords": ["sprint", "review", "weekly", "sync", "project-discussion", "business-communication", "progress-review"],
      "description": "Multi-person formal meeting minutes with clear agenda, decisions and action items",
      "naming": "YYYYMMDD-{type}-{topic}",
      "type_values": ["weekly-sync", "project-sync", "project-discussion", "business-communication", "meeting-report", "progress-review"]
    },
    "XX-discussion-notes": {
      "keywords": ["internal-discussion", "1on1", "brainstorming", "working-guide", "analysis", "action-plan"],
      "description": "Small-group discussion, 1on1 communication, personal analysis notes or working guides",
      "naming": "YYYYMMDD-internal-discussion-{topic}",
      "type_values": ["internal-discussion", "about", "independent-communication", "internal-communication"]
    },
    "XX-reports": {
      "keywords": ["proposal", "report", "summary", "tech-article", "review", "evaluation", "planning", "product-planning"],
      "description": "Formal proposals, product planning, milestone summaries, tech articles, review reports and other polished outputs",
      "naming": "YYYYMMDD-{topic}",
      "type_values": []
    },
    "XX-reference": {
      "keywords": ["training", "workshop", "conference", "learning", "lecture"],
      "description": "External training notes, conference sessions, learning materials",
      "naming": "YYYYMMDD-{source}-{topic}",
      "type_values": []
    }
  }
}
