{
  "_comment": "Wiki 候选发现规则配置。所有硬编码规则现已外迁至此文件，可直接修改无需改代码。",
  "heading_prefixes": [
    ["项目", "project"],
    ["方案", "project"],
    ["专项", "project"],
    ["机制", "topic"],
    ["流程", "topic"],
    ["规范", "topic"],
    ["策略", "topic"]
  ],
  "stopwords": [
    "项目", "方案", "机制", "讨论", "过程", "内容", "目标", "背景", "当前", "总结", "计划", "工作", "部门", "周报",
    "the", "and", "for", "with", "from"
  ],
  "low_value_titles": [
    "邮件信息", "会议信息", "会议议题", "下周工作计划", "问题与风险", "周报内容", "本周工作总结", "项目背景", "总体目标",
    "关键举措", "章节", "参考来源", "当前结论", "相关依据", "依据摘要", "重点提炼", "项目背景与目标",
    "讨论议题", "互动过程中的主要问题和回复", "级同学的建议", "周报内容提取", "周报内容提取结果"
  ],
  "low_value_prefixes": ["邮件", "会议", "本周", "下周", "问题", "相关", "当前"],
  "structural_titles": [
    "项目背景", "项目目标", "总体目标", "关键举措", "背景", "目标", "结论", "总结", "概述", "讨论记录",
    "行动方案", "讨论全过程", "参考来源", "依据摘要", "相关依据", "当前结论"
  ],
  "topic_noise_patterns": [
    "^周报内容提取",
    "^互动过程中的",
    "^讨论议题$",
    "^会议信息$",
    "^会议议题$",
    "^本周",
    "^下周",
    "^问题与风险$",
    "^.*的基本信息$",
    "^.*的建议$",
    "^💼"
  ],
  "path_weights": {
    "讨论思考": 4,
    "方案及汇报": 4,
    "目标管理": 4,
    "会议纪要": 3,
    "部门管理": 3,
    "周报": 1
  },
  "min_term_length": 2,
  "project_suffix_patterns": [
    "\\s*-\\s*\\d{4}年行动方案$",
    "行动方案$",
    "讨论全过程$",
    "项目讨论$"
  ],
  "page_type_priority": { "project": 3, "topic": 2, "term": 1 },
  "generic_term_suppress": ["AI", "AB", "VS", "OKR", "TODO"],
  "high_value_topic_hints": ["技术", "系统", "能力", "平台", "架构", "模型", "治理", "推荐", "搜索", "视觉检测", "鉴定", "识别"],
  "low_value_path_hints": ["周报", "模板", "例会", "邮件"],
  "low_value_term_patterns": [
    "^V?\\d+(?:\\.\\d+)+$",
    "^[A-Z]{1,2}$",
    "^AI.*评测"
  ],
  "low_value_title_patterns": [
    "^细化行动方案",
    "^AI 鉴定结果评测",
    "^.*定责到人"
  ],
  "candidate_evidence_thresholds": {
    "project": 2,
    "topic": 3,
    "term": 4
  }
}
