{
  "version": "3.3",
  "scan": {
    "mode": "search",
    "folders": ["INBOX", "周报"],
    "_note": "mode=search 跨全文件夹按关键词搜索（推荐，避免 IMPORTANT 周报漏扫）；mode=folder 按 folders list（旧行为）"
  },
  "filters": {
    "subject_keywords": ["周报", "周会", "week report", "weekly"],
    "sender_whitelist": [],
    "date_range_days": 7,
    "date_from": null
  },
  "output": {
    "dir": "${IRIS_OUTPUT_DIR}/weekly_reports",
    "filename_format": "{date}-周报-w{week}-{name}.md",
    "file_overwrite": false
  }
}
