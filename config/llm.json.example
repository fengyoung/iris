{
  "version": "3.6",
  "default_strategy": {
    "default_model_role": "base_model",
    "fallback_model_role": "adv_model",
    "prefer_lower_cost": true,
    "allow_auto_upgrade": true,
    "allow_auto_downgrade": true
  },
  "models": {
    "base_model": {
      "enabled": true,
      "default_model_id": "deepseek-v4-flash-zz",
      "models": {
        "deepseek-v4-flash-zz": {
          "channel": "zz_tokenhub",
          "model": "deepseek-v4-flash",
          "display_name": "DeepSeek V4 Flash (zz_tokenhub)",
          "multimodal": false,
          "max_context_tokens": 1000000,
          "max_tokens": 8192,
          "temperature": 0.2,
          "top_p": 1.0,
          "timeout_seconds": 60,
          "max_retries": 2,
          "priority": 10,
          "cost_level": "low",
          "reasoning_level": "standard",
          "supported_inputs": [
            "text"
          ],
          "use_cases": [
            "qa",
            "summary",
            "analysis_basic"
          ],
          "notes": "默认纯文本主力模型(zz_tokenhub 中转)"
        },
        "deepseek-v4-flash": {
          "channel": "deepseek",
          "model": "deepseek-v4-flash",
          "display_name": "DeepSeek V4 Flash (官方)",
          "multimodal": false,
          "max_context_tokens": 1000000,
          "max_tokens": 8192,
          "temperature": 0.2,
          "top_p": 1.0,
          "timeout_seconds": 60,
          "max_retries": 2,
          "priority": 5,
          "cost_level": "low",
          "reasoning_level": "standard",
          "supported_inputs": [
            "text"
          ],
          "use_cases": [
            "qa",
            "summary",
            "analysis_basic"
          ],
          "notes": "官方直连,base_model 降级链 fallback"
        }
      }
    },
    "adv_model": {
      "enabled": true,
      "default_model_id": "qwen3.8-max-zz",
      "models": {
        "qwen3.8-max-zz": {
          "channel": "zz_tokenhub",
          "model": "qwen3.8-max",
          "display_name": "Qwen 3.8 Max (zz_tokenhub)",
          "multimodal": true,
          "max_context_tokens": 200000,
          "max_tokens": 8192,
          "temperature": 0.2,
          "top_p": 1.0,
          "timeout_seconds": 300,
          "max_retries": 3,
          "priority": 70,
          "cost_level": "high",
          "reasoning_level": "advanced",
          "supported_inputs": [
            "text",
            "image"
          ],
          "use_cases": [
            "qa",
            "wiki_extract_multimodal",
            "wiki_rebuild",
            "analysis_complex",
            "image_understanding",
            "conflict_resolution"
          ],
          "notes": "旗舰模型,adv_model 新默认(zz_tokenhub 中转)"
        },
        "deepseek-v4-flash-vision-exp": {
          "channel": "deepseek",
          "model": "deepseek-v4-flash-vision-exp",
          "display_name": "DeepSeek V4 Flash Vision (Exp)",
          "multimodal": true,
          "max_context_tokens": 1000000,
          "max_tokens": 8192,
          "temperature": 0.2,
          "top_p": 1.0,
          "timeout_seconds": 120,
          "max_retries": 2,
          "priority": 60,
          "cost_level": "low",
          "reasoning_level": "standard",
          "supported_inputs": [
            "text",
            "image"
          ],
          "use_cases": [
            "qa",
            "wiki_extract_multimodal",
            "wiki_rebuild",
            "analysis_complex",
            "image_understanding",
            "conflict_resolution"
          ],
          "notes": "实验性视觉模型,adv_model 降级链 fallback(官方直连)"
        }
      }
    }
  },
  "routing": {
    "rules": [
      {
        "name": "user_force_adv_model",
        "enabled": true,
        "priority": 1,
        "match": {
          "user_selected_role": "adv_model"
        },
        "route_to": "adv_model",
        "fallback_to": "base_model",
        "description": "用户显式指定增强模型"
      },
      {
        "name": "user_force_base_model",
        "enabled": true,
        "priority": 2,
        "match": {
          "user_selected_role": "base_model"
        },
        "route_to": "base_model",
        "fallback_to": "adv_model",
        "description": "用户显式指定基础模型"
      },
      {
        "name": "multimodal_input_go_adv",
        "enabled": true,
        "priority": 5,
        "match": {
          "input_type": "multimodal"
        },
        "route_to": "adv_model",
        "fallback_to": "base_model",
        "description": "图文混合输入走增强模型"
      },
      {
        "name": "prompt_gen_go_base",
        "enabled": true,
        "priority": 7,
        "match": {
          "task_type": "prompt_gen"
        },
        "route_to": "base_model",
        "fallback_to": "adv_model",
        "description": "生成 adv_model 指令走 base_model"
      },
      {
        "name": "complex_analysis_go_adv",
        "enabled": true,
        "priority": 8,
        "match": {
          "task_type": "analysis",
          "complexity": "complex"
        },
        "route_to": "adv_model",
        "fallback_to": "base_model",
        "description": "复杂分析走增强模型"
      },
      {
        "name": "wiki_rebuild_go_adv",
        "enabled": true,
        "priority": 9,
        "match": {
          "task_type": "wiki_rebuild"
        },
        "route_to": "adv_model",
        "fallback_to": "base_model",
        "description": "Wiki 重建走增强模型"
      },
      {
        "name": "default-qa",
        "enabled": true,
        "priority": 10,
        "match": {
          "task_type": "qa"
        },
        "route_to": "base_model",
        "fallback_to": "adv_model",
        "description": "默认问答路由到 base_model"
      },
      {
        "name": "default_text_tasks_go_base",
        "enabled": true,
        "priority": 100,
        "match": {
          "input_type": "text"
        },
        "route_to": "base_model",
        "fallback_to": "adv_model",
        "description": "常规纯文本任务走基础模型（兜底）"
      }
    ]
  },
  "embedding": {
    "enabled": true,
    "model": "text-embedding-v3",
    "api_base_url": "${IRIS_BAILIAN_BASE_URL}",
    "api_key": "${IRIS_BAILIAN_API_KEY}",
    "timeout_seconds": 30,
    "max_retries": 2
  }
}
