          "priority": 125,
          "cost_level": "medium",
          "reasoning_level": "advanced",
          "supported_inputs": [
            "text"
          ],
          "use_cases": [
            "qa",
            "analysis_complex"
          ],
          "notes": "【不支持图片】2026-09-15 实测文本 2.9s；图像请求 HTTP 400（content.type 仅接受 text）→ multimodal=false",
          "provider": "openai",
          "api_base_url": "https://your-tokenhub.example.com/codex/v1"
        },
        "kimi-k2.6": {
          "channel": "zz_tokenhub",
          "model": "kimi-k2.6",
          "display_name": "Kimi K2.6 (zz_tokenhub)",
          "multimodal": true,
          "max_context_tokens": 262144,
          "max_tokens": 8192,
          "temperature": 0.2,
          "top_p": 1.0,
          "timeout_seconds": 120,
          "max_retries": 2,
          "priority": 120,
          "cost_level": "medium",
          "reasoning_level": "standard",
          "supported_inputs": [
            "text",
            "image"
          ],
          "use_cases": [
            "qa",
            "analysis_complex",
            "image_understanding"
          ],
          "notes": "2026-09-15 实测文本 0.6s / 图像 0.6s（图像识别正确）；max_context 按 K2 系列惯例推断",
          "provider": "anthropic",
          "api_base_url": "https://your-tokenhub.example.com/anthropic"
        }
      }
    }
  },
  "routing": {
    "rules": [
      {
        "name": "user_force_adv_model",
        "enabled": true,
        "priority": 1,
        "match": {
          "user_selected_role": "adv_model"
        },
        "route_to": "adv_model",
        "fallback_to": "base_model",
        "description": "用户显式指定增强模型"
      },
      {
        "name": "user_force_base_model",
        "enabled": true,
        "priority": 2,
        "match": {
          "user_selected_role": "base_model"
        },
        "route_to": "base_model",
        "fallback_to": "adv_model",
        "description": "用户显式指定基础模型"
      },
      {
        "name": "multimodal_input_go_adv",
        "enabled": true,
        "priority": 5,
        "match": {
          "input_type": "multimodal"
        },
        "route_to": "adv_model",
        "fallback_to": "base_model",
        "description": "图文混合输入走增强模型"
      },
      {
        "name": "weekly_report_extract_go_adv",
        "priority": 6,
        "match": {
          "use_case": "weekly_report_extraction"
        },
        "route_to": "adv_model",
        "fallback_to": "base_model",
        "enabled": true
      },
      {
        "name": "prompt_gen_go_base",
        "enabled": true,
        "priority": 7,
        "match": {
          "task_type": "prompt_gen"
        },
        "route_to": "base_model",
        "fallback_to": "adv_model",
        "description": "生成 adv_model 指令走 base_model"
      },
      {
        "name": "complex_analysis_go_adv",
        "enabled": true,
        "priority": 8,
        "match": {
          "task_type": "analysis",
          "complexity": "complex"
        },
        "route_to": "adv_model",
        "fallback_to": "base_model",
        "description": "复杂分析走增强模型"
      },
      {
        "name": "wiki_rebuild_go_adv",
        "enabled": true,
        "priority": 9,
        "match": {
          "task_type": "wiki_rebuild"
        },
        "route_to": "adv_model",
        "fallback_to": "base_model",
        "description": "Wiki 重建走增强模型"
      },
      {
        "name": "default-qa",
        "enabled": true,
        "priority": 10,
        "match": {
          "task_type": "qa"
        },
        "route_to": "base_model",
        "fallback_to": "adv_model",
        "description": "默认问答路由到 base_model"
      },
      {
        "name": "asr_correction_go_base",
        "enabled": true,
        "priority": 50,
        "match": {
          "task_type": "asr_correction"
        },
        "route_to": "base_model",
        "fallback_to": "adv_model",
        "description": "ASR 实时校正走基础模型"
      },
      {
        "name": "asr_misreading_go_base",
        "enabled": true,
        "priority": 51,
        "match": {
          "task_type": "asr_misreading"
        },
        "route_to": "base_model",
        "fallback_to": "adv_model",
        "description": "ASR 误识别批量生成走基础模型"
      },
      {
        "name": "asr_hotword_go_base",
        "enabled": true,
        "priority": 52,
        "match": {
          "task_type": "asr_hotword"
        },
        "route_to": "base_model",
        "fallback_to": "adv_model",
        "description": "ASR 热词提取走基础模型"
      },
      {
        "name": "default_text_tasks_go_base",
        "enabled": true,
        "priority": 100,
        "match": {
          "input_type": "text"
        },
        "route_to": "base_model",
        "fallback_to": "adv_model",
        "description": "常规纯文本任务走基础模型（兜底）"
      }
    ]
  },
  "embedding": {
    "enabled": true,
    "model": "text-embedding-v3",
    "api_base_url": "${IRIS_BAILIAN_BASE_URL}",
    "api_key": "${IRIS_BAILIAN_API_KEY}",
    "timeout_seconds": 30,
    "max_retries": 2
  }
}
